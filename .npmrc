strict-peer-dependencies=true
auto-install-peers=false
shamefully-hoist=false

# Hoist Preact and its compat layer so react aliases resolve correctly
public-hoist-pattern[]=preact
public-hoist-pattern[]=preact-render-to-string
public-hoist-pattern[]=@preact/signals
public-hoist-pattern[]=@preact/signals-core

# Prevent react from being hoisted — force preact/compat resolution
public-hoist-pattern[]=!react
public-hoist-pattern[]=!react-dom

# Lockfile
prefer-frozen-lockfile=true
