{
  "name": "@cliui/elements",
  "version": "0.0.0",
  "description": "Terminal UI component library \u2014 HTML elements, primitives, and styled components",
  "license": "MIT",
  "author": "Olavo Amorim Santos<olavo.santos@micra.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/olavoasantos/cliui.git",
    "directory": "cliui/elements"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "test:unit": "vitest run --config=vitest.unit.config.ts",
    "test:integration": "vitest run --config=vitest.integration.config.ts",
    "test:performance": "vitest bench --run --config=vitest.bench.config.ts",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@cliui/terminal": "workspace:*",
    "shiki": "^4.0.2"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  }
}
