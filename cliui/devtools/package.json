{
  "name": "@cliui/devtools",
  "version": "0.0.0",
  "description": "Chrome DevTools Protocol bridge for @cliui/terminal",
  "license": "MIT",
  "author": "Olavo Amorim Santos<olavo.santos@micra.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/olavoasantos/cliui.git",
    "directory": "cliui/devtools"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist node_modules",
    "dev": "vite build --watch",
    "docs:generate": "echo 'noop'",
    "format:check": "oxfmt check . --config .prettierrc.mjs --no-error-on-unmatched-pattern",
    "format:fix": "oxfmt . --config .prettierrc.mjs --no-error-on-unmatched-pattern",
    "lint:check": "oxlint -c oxlint.json --silent",
    "lint:fix": "oxlint -c oxlint.json --fix",
    "test:check": "run-p test:unit test:integration",
    "test:check:all": "run-p test:unit test:integration",
    "test:unit": "vitest run --config=vitest.unit.config.ts",
    "test:unit:watch": "vitest --config=vitest.unit.config.ts",
    "test:integration": "vitest run --config=vitest.integration.config.ts --passWithNoTests",
    "test:integration:watch": "vitest --config=vitest.integration.config.ts",
    "test:performance": "echo 'no benchmarks'",
    "test:performance:watch": "echo 'no benchmarks'",
    "test:performance:record": "echo 'no benchmarks'",
    "test:performance:compare": "echo 'no benchmarks'",
    "type:check": "tsc --noEmit",
    "check": "run-p type:check lint:check format:check test:check"
  },
  "dependencies": {
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@cliui/dom": "workspace:*",
    "@cliui/internals": "workspace:*",
    "@cliui/terminal": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "terser": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@cliui/dom": "workspace:*",
    "@cliui/terminal": "workspace:*"
  }
}
