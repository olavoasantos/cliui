{
  "name": "@cliui/terminal",
  "version": "0.0.0",
  "description": "Terminal UI engine — CSS, Layout, Renderer, and Terminal I/O",
  "license": "MIT",
  "author": "Olavo Amorim Santos<olavo.santos@micra.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/olavoasantos/cliui.git",
    "directory": "cliui/terminal"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./css": {
      "types": "./dist/css/index.d.ts",
      "import": "./dist/css/index.js",
      "require": "./dist/css/index.cjs"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js",
      "require": "./dist/layout/index.cjs"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js",
      "require": "./dist/renderer/index.cjs"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build",
    "test:unit": "vitest run --config=vitest.unit.config.ts",
    "test:integration": "vitest run --config=vitest.integration.config.ts",
    "test:performance": "vitest bench --run --config=vitest.bench.config.ts",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@cliui/dom": "workspace:*"
  }
}
