{
  "name": "@cliui/dom",
  "version": "0.0.0",
  "description": "Standalone DOM polyfill for Node.js — Window, Document, Element, Event, MutationObserver, and more",
  "license": "MIT",
  "author": "Olavo Amorim Santos<olavo.santos@micra.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/olavoasantos/cliui.git",
    "directory": "cliui/dom"
  },
  "files": [
    "dist",
    "register.d.ts"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./register": {
      "types": "./register.d.ts"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist node_modules",
    "dev": "vite build --watch",
    "docs:generate": "echo 'noop'",
    "format:check": "oxfmt check . --config .prettierrc.mjs --no-error-on-unmatched-pattern",
    "format:fix": "oxfmt . --config .prettierrc.mjs --no-error-on-unmatched-pattern",
    "lint:check": "oxlint -c oxlint.json --silent",
    "lint:fix": "oxlint -c oxlint.json --fix",
    "test:check": "run-p test:unit test:integration",
    "test:check:all": "run-p test:unit test:integration test:performance",
    "test:unit": "vitest run --config=vitest.unit.config.ts",
    "test:unit:watch": "vitest --config=vitest.unit.config.ts",
    "test:integration": "vitest run --config=vitest.integration.config.ts",
    "test:integration:watch": "vitest --config=vitest.integration.config.ts",
    "test:performance": "vitest bench --run --config=vitest.bench.config.ts",
    "test:performance:watch": "vitest bench --config=vitest.bench.config.ts",
    "test:performance:record": "vitest bench --run --config=vitest.bench.config.ts --outputJson=../../.testing/performance/reference.json",
    "test:performance:compare": "vitest bench --run --config=vitest.bench.config.ts --compare=../../.testing/performance/reference.json",
    "type:check": "tsc --noEmit",
    "check": "run-p type:check lint:check format:check test:check"
  },
  "devDependencies": {
    "@cliui/internals": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "terser": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
