{
  "name": "@cliui/monorepo",
  "version": "0.0.0",
  "bugs": {
    "url": "https://github.com/olavoasantos/cliui/issues?q=is:issue+is:open+label:%22Project:+terminal%22+label:%22Type:+fix%22"
  },
  "license": "MIT",
  "author": "Olavo Amorim Santos<olavo.santos@micra.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/olavoasantos/cliui.git",
    "directory": "packages/terminal"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components.js",
      "require": "./dist/components.cjs"
    }
  },
  "scripts": {
    "build": "pnpm -r --filter=./cliui/* run build",
    "check": "pnpm build && pnpm -r --filter=./cliui/* run check",
    "clean": "pnpm -r --filter=./cliui/* run clean",
    "dev": "pnpm -r --filter=./cliui/* run dev",
    "docs:generate": "pnpm -r --filter=./cliui/* run docs:generate",
    "fix": "run-p *:fix",
    "format:check": "pnpm -r --filter=./cliui/* run format:check",
    "format:fix": "pnpm -r --filter=./cliui/* run format:fix",
    "lint:check": "pnpm -r --filter=./cliui/* run lint:check",
    "lint:fix": "pnpm -r --filter=./cliui/* run lint:fix",
    "prepare": "husky .config/git-hooks",
    "test:check": "pnpm -r --filter=./cliui/* run test:check",
    "test:check:all": "pnpm -r --filter=./cliui/* run test:check:all",
    "test:unit": "pnpm -r --filter=./cliui/* run test:unit",
    "test:unit:watch": "pnpm -r --filter=./cliui/* run test:unit:watch",
    "test:integration": "pnpm -r --filter=./cliui/* run test:integration",
    "test:integration:watch": "pnpm -r --filter=./cliui/* run test:integration:watch",
    "test:performance": "pnpm -r --filter=./cliui/* run test:performance",
    "test:performance:watch": "pnpm -r --filter=./cliui/* run test:performance:watch",
    "test:performance:record": "pnpm -r --filter=./cliui/* run test:performance:record",
    "test:performance:compare": "pnpm -r --filter=./cliui/* run test:performance:compare",
    "type:check": "pnpm -r --filter=./cliui/* run type:check",
    "version:bump": "changeset"
  },
  "dependencies": {
    "@cliui/dom": "workspace:*"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/node": "catalog:",
    "changesets": "^1.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,md}": [
      "oxlint --config oxlint.json --fix",
      "oxfmt --config .prettierrc.mjs --no-error-on-unmatched-pattern --write"
    ],
    "*.{js,jsx,json,css,yaml,yml}": [
      "oxfmt check --config .prettierrc.mjs --no-error-on-unmatched-pattern"
    ]
  }
}
